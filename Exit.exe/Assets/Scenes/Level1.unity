  m_GameObject: {fileID: 1183269221}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "...You have awakened.\r\nYou don\u2019t know how long you\u2019ve been
    down here,  but someone is watching you. \r\nThis basement is not a refuge\u2026
    it is a test.\r\nTo get out, you will have to survive.  Behind that door lies
    your freedom\u2026\r\n\r\nFirst trial:\r\nYou are not alone in the room. There
    is something else with you.\r\nIt moves in the darkness\u2026 and it is hunting
    you.\r\nThree keys have been hidden. Find them.\r\nBut remember\u2026 if it sees
    you, it will be too late.\r\n\r\nSecond trial:\r\nYou cannot run. You cannot
    hide. Stay completely still.\r\nBreathe.\r\nAim.\r\nA weapon will be given to
    you. And you will have to use it.\r\nThey will come for you. Do not miss.\r\n\r\nThere
    are no second chances.\r\nEscape\u2026 if you can."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6b3c8d6ba4655e642be229cb39a31370, type: 2}
